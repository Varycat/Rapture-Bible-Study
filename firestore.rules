rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailKey() {
      return request.auth.token.email;
    }
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function hasPermission(studyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/permissions/$(emailKey()))
        && studyId in get(/databases/$(database)/documents/permissions/$(emailKey())).data.allowedStudies;
    }
    function canReadStudy(studyId) {
      return isOwner() || hasPermission(studyId);
    }

    match /owners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if false;
    }

    match /permissions/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isOwner());
      allow create, update, delete: if isOwner();
    }

    match /progress/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isOwner());
      allow create, update: if signedIn() && request.auth.token.email == email;
      allow delete: if isOwner();
    }

    match /studies/{studyId} {
      allow read: if canReadStudy(studyId);
      allow create, update, delete: if isOwner();

      match /topics/{topicId} {
        allow read: if canReadStudy(studyId);
        allow create, update, delete: if isOwner();
      }

      match /verses/{verseId} {
        allow read: if canReadStudy(studyId);
        allow create, update, delete: if isOwner();
      }
    }
  }
}
