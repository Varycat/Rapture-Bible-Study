rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function emailKey() {
      return request.auth.token.email;
    }
    function isOwner() {
      return signedIn()
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }
    function hasPermission(studyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/permissions/$(emailKey()))
        && (studyId in get(/databases/$(database)/documents/permissions/$(emailKey())).data.allowedStudies
            // Legacy: old permission docs may still grant 'dead' for 'state-of-the-dead'.
            || (studyId == 'state-of-the-dead'
                && 'dead' in get(/databases/$(database)/documents/permissions/$(emailKey())).data.allowedStudies));
    }
    function canReadStudy(studyId) {
      return isOwner() || hasPermission(studyId);
    }

    match /owners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow write: if false;
    }

    match /permissions/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isOwner());
      allow create, update, delete: if isOwner();
    }

    match /progress/{email} {
      allow read: if signedIn() && (request.auth.token.email == email || isOwner());
      allow create, update: if signedIn() && request.auth.token.email == email;
      allow delete: if isOwner();
    }

    // Shared appearance photos (hero + study banners): owner sets, everyone sees.
    match /branding/{item} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();
    }

    // Installed Bible versions: owner installs, every signed-in reader can read.
    match /bibles/{versionId} {
      allow read: if signedIn();
      allow create, update, delete: if isOwner();

      match /books/{bookId} {
        allow read: if signedIn();
        allow create, update, delete: if isOwner();
      }
    }

    // Personal notes: private to each user.
    match /notes/{email} {
      allow read, create, update, delete: if signedIn() && request.auth.token.email == email;
    }

    match /studies/{studyId} {
      allow read: if canReadStudy(studyId);
      allow create, update, delete: if isOwner();

      match /topics/{topicId} {
        allow read: if canReadStudy(studyId);
        allow create, update, delete: if isOwner();
      }

      match /verses/{verseId} {
        allow read: if canReadStudy(studyId);
        allow create, update, delete: if isOwner();
      }
    }
  }
}
